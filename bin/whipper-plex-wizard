#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

APP="Whipper Plex Wizard"
CFG_DIR="$HOME/.config/whipper-plex-wizard"
CFG_FILE="$CFG_DIR/settings.env"
mkdir -p "$CFG_DIR"

# ---------- defaults ----------
DEVICE="${DEVICE:-}"
OUT_ROOT="${OUT_ROOT:-$HOME/Music}"
MULTIDISC="${MULTIDISC:-no}"          # yes/no
INCLUDE_TRACK_ARTIST="${INCLUDE_TRACK_ARTIST:-no}" # yes/no
COVER_MODE="${COVER_MODE:-complete}"  # file|embed|complete
PROMPT_RELEASE="${PROMPT_RELEASE:-yes}" # yes/no
ALLOW_UNKNOWN="${ALLOW_UNKNOWN:-no}"    # yes/no
KEEP_GOING="${KEEP_GOING:-yes}"         # yes/no
MAX_RETRIES="${MAX_RETRIES:-5}"         # 0 = infinity
DAMAGED_MAX_RETRIES="${DAMAGED_MAX_RETRIES:-1}" # damaged disc salvage mode
PAD_TRACK_NUMBERS="${PAD_TRACK_NUMBERS:-yes}" # yes/no
EJECT_AFTER="${EJECT_AFTER:-no}"        # yes/no
EJECT_TIMEOUT_SECONDS=15
BAD_DISC_TRACK_Q_THRESHOLD=1000
BAD_DISC_TOTAL_Q_THRESHOLD=5000

# Whipper 0.10.0/cdparanoia can crash while trying some high offsets.
# Keep automatic search to common offsets with absolute values <= 587.
SAFE_OFFSET_SEARCH="+6,+48,+102,+30,+12,+103,+96,+98,-472,+97,-24,+572,-491,+91,+145,+86,+355,+79,+564,-496,0,-436,+94,+106,+117,+92,-54,-582,-489,+534,+122,+111,+108,+87,-495,-494,-12,+234,+138"

cfg_is_safe() {
  local line key value

  [[ -f "$CFG_FILE" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue

    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      DEVICE|OUT_ROOT|MULTIDISC|INCLUDE_TRACK_ARTIST|COVER_MODE|PROMPT_RELEASE|ALLOW_UNKNOWN|KEEP_GOING|MAX_RETRIES|DAMAGED_MAX_RETRIES|PAD_TRACK_NUMBERS|EJECT_AFTER) ;;
      *) return 1 ;;
    esac

    # The wizard writes shell-escaped scalar assignments. Reject obvious code.
    [[ "$value" == *'$'* || "$value" == *'`'* || "$value" == *';'* || "$value" == *'&'* || "$value" == *'|'* || "$value" == *'<'* || "$value" == *'>'* || "$value" == *'('* || "$value" == *')'* ]] && return 1
  done < "$CFG_FILE"

  return 0
}

load_cfg() {
  if [[ -f "$CFG_FILE" ]]; then
    if cfg_is_safe; then
      source "$CFG_FILE"
    else
      echo "⚠ Warning:  Ignoring unsafe or unrecognized settings file: $CFG_FILE"
    fi
  fi
}

is_yes() {
  case "${1,,}" in
    y|yes) return 0 ;;
    *) return 1 ;;
  esac
}

is_no() {
  case "${1,,}" in
    n|no) return 0 ;;
    *) return 1 ;;
  esac
}

is_nonneg_int() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

coerce_yes_no() {
  local answer="$1"
  local default="$2"

  if [[ -z "${answer:-}" ]]; then
    echo "$default"
  elif is_yes "$answer"; then
    echo yes
  elif is_no "$answer"; then
    echo no
  else
    return 1
  fi
}

run_logged() {
  local log_file="$1"
  shift

  set +e
  "$@" 2>&1 | tee "$log_file"
  local status=${PIPESTATUS[0]}
  set -e
  return "$status"
}

looks_like_cover_art_network_failure() {
  local log_file="$1"

  grep -Eq 'getCoverArt|Cover Art Archive|musicbrainzngs\.musicbrainz\.NetworkError|HTTP Error 30[0-9]' "$log_file"
}

offset_find_confirmed() {
  local log_file="$1"

  grep -Eq 'Read offset of device is:|adding read offset to configuration file' "$log_file"
}

rip_log_has_failed_tracks() {
  local log_file="$1"

  grep -Eq "giving up on track [0-9]+" "$log_file"
}

stage_has_flacs() {
  local stage="$1"

  find "$stage" -type f -name '*.flac' -print -quit | grep -q .
}

diagnose_rip_failure() {
  local log_file="$1"

  if looks_like_cover_art_network_failure "$log_file"; then
    echo "   Cause: Whipper failed while fetching cover art."
    echo "   Try the cover-art-free retry when offered."
  elif grep -Eq "unsupported operand type\(s\) for /: 'NoneType' and 'float'" "$log_file"; then
    echo "   Cause: Whipper 0.10.0 crashed while writing its rip log after failed/unreadable tracks."
    echo "   The audio failure happened earlier; the traceback is a Whipper logging bug around missing track data."
    echo "   Keep any staged partial rip if useful, and inspect the completed/failed track summary."
  elif grep -Eq "giving up on track|couldn't read any frames|file size 0 did not match expected size" "$log_file"; then
    echo "   Cause: cdparanoia could not get a usable read for at least one track."
    echo "   Note: Whipper 0.10.0 can print a ZeroDivisionError traceback for this known unreadable-frame failure mode."
    echo "   Try cleaning the disc, reinserting it, and ripping again."
    echo "   If this happens repeatedly on the same track, try another drive or inspect the disc for damage."
  elif grep -Eq "requested release id .* none of the found releases match" "$log_file"; then
    echo "   Cause: the selected MusicBrainz release did not match this disc."
    echo "   Try again and choose a different numbered release."
  elif grep -Eq "output directory .* is a finished rip" "$log_file"; then
    echo "   Cause: Whipper thinks this album was already ripped in the staging area."
    echo "   This should be rare; try the rip again."
  else
    echo "   Check the Whipper output above for the exact failure."
  fi
}

choose_release_id() {
  local selected_file
  selected_file="$(mktemp -t whipper-release-XXXXXX)"

  set +e
  python3 - "$DEVICE" "$selected_file" <<'PY'
import sys
from whipper.common import common, config, mbngs, program, task
from whipper.common import drive
from whipper.program import utils

device = sys.argv[1]
selected_file = sys.argv[2]

try:
    cfg = config.Config()
    prog = program.Program(cfg)
    runner = task.SyncRunner()

    utils.load_device(device)
    utils.unmount_device(device)
    if drive.get_cdrom_drive_status(device) == 1:
        print("No CD detected; insert one and retry.", file=sys.stderr)
        raise SystemExit(1)

    toc = prog.getFastToc(runner, device)
    discid = toc.getMusicBrainzDiscId()
    disc_duration = toc.duration()
    releases = mbngs.musicbrainz(discid)
except Exception as exc:
    print("Could not build numbered MusicBrainz release list: %s" % exc, file=sys.stderr)
    raise SystemExit(1)

if not releases:
    raise SystemExit(1)

def safe_int(value, default=0):
    try:
        return int(value)
    except (TypeError, ValueError):
        return default

def duration_delta(md):
    if not md.duration:
        return 10**9
    return abs(md.duration - disc_duration)

def searchable_text(md):
    bits = [
        md.releaseTitle,
        getattr(md, "title", ""),
        getattr(md, "mediumTitle", ""),
        md.catalogNumber,
    ]
    return " ".join(str(bit or "") for bit in bits).lower()

def release_score(md):
    score = duration_delta(md)
    text = searchable_text(md)
    release_type = str(md.releaseType or "").lower()
    disc_total = safe_int(md.discTotal)

    # Duration alone often picks bootlegs or box-set discs. Prefer the ordinary
    # standalone album when several MusicBrainz matches have the same TOC.
    if release_type and release_type != "album":
        score += 180000
    if disc_total > 1:
        score += 160000
    if "bootleg" in text:
        score += 600000
    if "disc " in text and " of " in text:
        score += 160000
    if "box" in text and "set" in text:
        score += 100000
    if not md.barcode:
        score += 20000
    return score

def print_release(idx, md, marker=""):
    print()
    print("%d)%s %s - %s" % (idx, marker, md.artist, md.releaseTitle))
    if md.duration:
        print("   Duration: %s" % common.formatTime(md.duration / 1000.0))
    print("   Type    : %s" % md.releaseType)
    if md.countries:
        print("   Country : %s" % ", ".join(md.countries))
    if md.barcode:
        print("   Barcode : %s" % md.barcode)
    if md.catalogNumber:
        print("   Cat no  : %s" % md.catalogNumber)
    if md.discNumber and md.discTotal and safe_int(md.discTotal) > 1:
        print("   Disc    : %s of %s" % (md.discNumber, md.discTotal))
    print("   Release : %s" % md.mbid)

scores = [release_score(md) for md in releases]
default_index = scores.index(min(scores))

print()
if len(releases) == 1:
    print("Matching MusicBrainz release:")
    print_release(1, releases[0], " [auto]")
    selected = releases[0].mbid
    with open(selected_file, "w", encoding="utf-8") as handle:
        handle.write(selected + "\n")
    print()
    print("Auto-selected the only MusicBrainz match: %s" % selected)
    raise SystemExit(0)

print("Matching MusicBrainz releases:")
for idx, md in enumerate(releases, 1):
    marker = " [suggested]" if idx - 1 == default_index else ""
    print_release(idx, md, marker)

try:
    tty = open("/dev/tty", "r", encoding="utf-8")
except OSError:
    tty = sys.stdin

while True:
    print("\nChoose release number [%d], paste a release ID, or q to fall back to Whipper prompt: " % (default_index + 1), end="", flush=True)
    choice = tty.readline()
    if choice == "":
        raise SystemExit(2)
    choice = choice.strip()
    if not choice:
        selected = releases[default_index].mbid
        break
    if choice.lower() in {"q", "quit", "fallback"}:
        raise SystemExit(2)
    if choice.isdigit():
        number = int(choice)
        if 1 <= number <= len(releases):
            selected = releases[number - 1].mbid
            break
    for md in releases:
        if choice == md.mbid:
            selected = md.mbid
            break
    else:
        print("Please enter a number from 1-%d, a listed release ID, or q." % len(releases))
        continue
    break

with open(selected_file, "w", encoding="utf-8") as handle:
    handle.write(selected + "\n")

print("Selected release: %s" % selected)
PY
  local status=$?
  set -e

  if [[ $status -eq 0 && -s "$selected_file" ]]; then
    RELEASE_ID="$(<"$selected_file")"
    rm -f -- "$selected_file"
    return 0
  fi

  rm -f -- "$selected_file"
  return "$status"
}

save_cfg() {
  {
    echo "# $APP settings"
    printf 'DEVICE=%q\n' "$DEVICE"
    printf 'OUT_ROOT=%q\n' "$OUT_ROOT"
    printf 'MULTIDISC=%q\n' "$MULTIDISC"
    printf 'INCLUDE_TRACK_ARTIST=%q\n' "$INCLUDE_TRACK_ARTIST"
    printf 'COVER_MODE=%q\n' "$COVER_MODE"
    printf 'PROMPT_RELEASE=%q\n' "$PROMPT_RELEASE"
    printf 'ALLOW_UNKNOWN=%q\n' "$ALLOW_UNKNOWN"
    printf 'KEEP_GOING=%q\n' "$KEEP_GOING"
    printf 'MAX_RETRIES=%q\n' "$MAX_RETRIES"
    printf 'DAMAGED_MAX_RETRIES=%q\n' "$DAMAGED_MAX_RETRIES"
    printf 'PAD_TRACK_NUMBERS=%q\n' "$PAD_TRACK_NUMBERS"
    printf 'EJECT_AFTER=%q\n' "$EJECT_AFTER"
  } > "$CFG_FILE"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1
}

ensure_deps() {
  local missing=()
  for c in whipper flac; do
    need_cmd "$c" || missing+=("$c")
  done
  need_cmd metaflac || missing+=("flac")

  # Pillow for cover art embed/complete (Debian/Ubuntu package: python3-pil)
  if [[ "$COVER_MODE" == "embed" || "$COVER_MODE" == "complete" ]]; then
    dpkg -s python3-pil >/dev/null 2>&1 || missing+=("python3-pil")
  fi

  if ((${#missing[@]}==0)); then
    echo "✔ Success: Dependencies look OK."
    return 0
  fi

  echo "Missing packages: ${missing[*]}"
  read -rp "Install them now with apt (requires sudo)? [y/N] " yn
  if is_yes "$yn"; then
    if sudo apt update && sudo apt install -y whipper flac python3-pil; then
      echo "✔ Success: Installed."
    else
      echo "✘ Fail: Package install failed. Check the apt output above."
      return 1
    fi
  else
    echo "Skipping install. You can install later with:"
    echo "  sudo apt update && sudo apt install -y whipper flac python3-pil"
  fi
}

pick_device() {
  echo
  echo "Available CD devices (common):"
  local devs=()
  # Prefer /dev/cdrom if present
  [[ -e /dev/cdrom ]] && devs+=("/dev/cdrom")
  # Add sr* devices
  for d in /dev/sr*; do
    [[ -e "$d" ]] && devs+=("$d")
  done

  if ((${#devs[@]}==0)); then
    echo "✘ Fail: I can't see /dev/cdrom or /dev/sr* on this system."
    echo "   If your drive is plugged in, check: lsblk, dmesg | tail"
    return 1
  fi

  echo "Select a device:"
  select choice in "${devs[@]}" "Enter manually"; do
    case "$REPLY" in
      ''|*[!0-9]*)
        echo "Please enter a number from the list."
        ;;
      *)
        if [[ -z "${choice:-}" ]]; then
          echo "Please enter a number from the list."
          continue
        fi
        if [[ "$choice" == "Enter manually" ]]; then
          read -rp "Enter device path (e.g. /dev/sr0): " manual
          DEVICE="$manual"
        else
          DEVICE="$choice"
        fi
        break
        ;;
    esac
  done

  if [[ ! -e "$DEVICE" ]]; then
    echo "✘ Fail: Device does not exist - $DEVICE"
    return 1
  fi

  if [[ ! -r "$DEVICE" ]]; then
    echo "⚠ Warning:  No read permission for $DEVICE."
    echo "   Try: sudo usermod -aG cdrom \"$USER\"  (then log out/in)"
    echo "   Avoid running the wizard with sudo unless you intentionally want root-owned config/output."
  fi

  echo "✔ Success: Using device - $DEVICE"
  save_cfg
}

edit_prefs() {
  local v new

  echo
  echo "Current settings:"
  echo "  Output root:           $OUT_ROOT"
  echo "  Multi-disc folders:    $MULTIDISC"
  echo "  Track artist in name:  $INCLUDE_TRACK_ARTIST"
  echo "  Cover art mode:        $COVER_MODE (file|embed|complete)"
  echo "  Prompt release pick:   $PROMPT_RELEASE"
  echo "  Allow unknown discs:   $ALLOW_UNKNOWN"
  echo "  Keep going on errors:  yes (always; preserves partial albums)"
  echo "  Max retries/track:     $MAX_RETRIES"
  echo "  Damaged mode retries:  $DAMAGED_MAX_RETRIES"
  echo "  Pad track numbers:     $PAD_TRACK_NUMBERS"
  echo "  Eject after rip:       $EJECT_AFTER"
  echo

  read -rp "Output root directory for music (ENTER to keep): " v
  [[ -n "${v:-}" ]] && OUT_ROOT="$v"

  read -rp "Put multi-disc albums in CD1/CD2 folders? [y/N] " v
  if [[ -n "${v:-}" ]]; then
    if new="$(coerce_yes_no "$v" no)"; then
      MULTIDISC="$new"
    else
      echo "Keeping $MULTIDISC (please enter yes or no)."
    fi
  fi

  read -rp "Include track artist in filename (useful for compilations)? [y/N] " v
  if [[ -n "${v:-}" ]]; then
    if new="$(coerce_yes_no "$v" no)"; then
      INCLUDE_TRACK_ARTIST="$new"
    else
      echo "Keeping $INCLUDE_TRACK_ARTIST (please enter yes or no)."
    fi
  fi

  read -rp "Cover art mode: file/embed/complete (ENTER to keep: $COVER_MODE): " v
  if [[ -n "${v:-}" ]]; then
    case "${v,,}" in
      file|embed|complete) COVER_MODE="${v,,}" ;;
      *) echo "Keeping $COVER_MODE (invalid input)." ;;
    esac
  fi

  read -rp "Prompt if multiple MusicBrainz releases match? [Y/n] " v
  if [[ -n "${v:-}" ]]; then
    if new="$(coerce_yes_no "$v" yes)"; then
      PROMPT_RELEASE="$new"
    else
      echo "Keeping $PROMPT_RELEASE (please enter yes or no)."
    fi
  fi

  read -rp "Allow ripping even if MusicBrainz can't identify the disc? [y/N] " v
  if [[ -n "${v:-}" ]]; then
    if new="$(coerce_yes_no "$v" no)"; then
      ALLOW_UNKNOWN="$new"
    else
      echo "Keeping $ALLOW_UNKNOWN (please enter yes or no)."
    fi
  fi

  read -rp "Max retries per track (0=infinite, ENTER to keep: $MAX_RETRIES): " v
  if [[ -n "${v:-}" ]]; then
    if is_nonneg_int "$v"; then
      MAX_RETRIES="$v"
    else
      echo "Keeping $MAX_RETRIES (max retries must be a non-negative integer)."
    fi
  fi

  read -rp "Damaged disc max retries per track (ENTER to keep: $DAMAGED_MAX_RETRIES): " v
  if [[ -n "${v:-}" ]]; then
    if is_nonneg_int "$v"; then
      DAMAGED_MAX_RETRIES="$v"
    else
      echo "Keeping $DAMAGED_MAX_RETRIES (damaged retries must be a non-negative integer)."
    fi
  fi

  read -rp "Pad track numbers to 01/02/... after ripping? [Y/n] " v
  if [[ -n "${v:-}" ]]; then
    if new="$(coerce_yes_no "$v" yes)"; then
      PAD_TRACK_NUMBERS="$new"
    else
      echo "Keeping $PAD_TRACK_NUMBERS (please enter yes or no)."
    fi
  fi

  read -rp "Eject tray after rip or published partial rip? [y/N] " v
  if [[ -n "${v:-}" ]]; then
    if new="$(coerce_yes_no "$v" no)"; then
      EJECT_AFTER="$new"
    else
      echo "Keeping $EJECT_AFTER (please enter yes or no)."
    fi
  fi

  mkdir -p "$OUT_ROOT"
  save_cfg
  echo "✔ Saved."
}

drive_setup() {
  ensure_deps || return 1
  if [[ -z "$DEVICE" ]]; then
    pick_device || return 1
  fi

  echo
  echo "=== Drive setup (EAC-like) ==="
  echo "1) Analyze drive cache behaviour"
  echo "2) Find drive offset safely (AccurateRip, avoids known high-offset crash)"
  echo "3) Find drive offset with a known/manual offset"
  echo "4) Back"
  echo
  read -rp "Choose [1-4]: " ch

  case "$ch" in
    1)
      echo
      echo "Insert a relatively common CD, then press ENTER."
      read -r
      if whipper drive analyze -d "$DEVICE"; then
        echo "✔ Done."
      else
        echo "✘ Fail: Drive analysis failed."
        echo "   Check the disc is inserted, the device is correct, and your user can read $DEVICE."
        return 1
      fi
      ;;
    2)
      echo
      echo "This uses a restricted offset list to avoid a known Whipper/cdparanoia crash with high offsets."
      echo "Tip: you can inspect your drive and any saved offset with:"
      echo "  whipper drive list"
      echo
      whipper drive list
      echo
      echo "Insert a common CD (likely in AccurateRip), then press ENTER."
      read -r
      local offset_log
      offset_log="$(mktemp -t whipper-offset-XXXXXX.log)"
      if run_logged "$offset_log" whipper offset find -d "$DEVICE" -o "$SAFE_OFFSET_SEARCH" && offset_find_confirmed "$offset_log"; then
        rm -f -- "$offset_log"
        echo "✔ Done (confirmed offsets are saved into whipper.conf automatically)."
      else
        rm -f -- "$offset_log"
        echo "✘ Fail: Offset detection failed."
        echo "   Try a different common CD, clean the disc, or use option 3 if you know the offset."
        return 1
      fi
      ;;
    3)
      echo
      echo "Use this if you found the drive offset from AccurateRip/online."
      echo "Whipper will verify the supplied offset against the inserted disc."
      read -rp "Enter one offset or comma-separated offsets (e.g. 6 or -102,+6): " off
      if [[ -z "${off:-}" ]]; then
        echo "No offset entered."
        return 1
      fi
      if [[ ! "$off" =~ ^[+-]?[0-9]+([,][+-]?[0-9]+)*$ ]]; then
        echo "✘ Fail: Invalid offset list. Use integers separated by commas, e.g. 6 or -102,+6."
        return 1
      fi
      echo "Insert a common CD (likely in AccurateRip), then press ENTER."
      read -r
      local offset_log
      offset_log="$(mktemp -t whipper-offset-XXXXXX.log)"
      if run_logged "$offset_log" whipper offset find -d "$DEVICE" -o "$off" && offset_find_confirmed "$offset_log"; then
        rm -f -- "$offset_log"
        echo "✔ Done (confirmed offsets are saved into whipper.conf automatically)."
      else
        rm -f -- "$offset_log"
        echo "✘ Fail: Offset verification failed for $off"
        return 1
      fi
      ;;
    *)
      ;;
  esac
}

track_template() {
  # Plex-ish: Artist/Album (Year)/01 - Title.flac
  # If compilation, MusicBrainz album artist is usually "Various Artists" so folder stays sane.
  local base
  if [[ "$INCLUDE_TRACK_ARTIST" == "yes" ]]; then
    base="%t - %a - %n"
  else
    base="%t - %n"
  fi

  if [[ "$MULTIDISC" == "yes" ]]; then
    echo "%A/%d (%y)/CD%N/$base"
  else
    echo "%A/%d (%y)/$base"
  fi
}

disc_template() {
  # Hide disc-level artefacts in album/.whipper/
  if [[ "$MULTIDISC" == "yes" ]]; then
    echo "%A/%d (%y)/.whipper/CD%N/%A - %d"
  else
    echo "%A/%d (%y)/.whipper/%A - %d"
  fi
}

pad_tracks_in_dirs() {
  local dirs=("$@")
  for dir in "${dirs[@]}"; do
    [[ -d "$dir" ]] || continue
    shopt -s nullglob
    local files=("$dir"/*.flac)
    shopt -u nullglob
    ((${#files[@]}==0)) && continue

    for f in "${files[@]}"; do
      local base new num rest
      base="$(basename "$f")"

      # Match "1 - Title.flac" or "1- Title.flac" (with flexible spaces)
      if [[ "$base" =~ ^([0-9]{1,2})[[:space:]]*-[[:space:]]*(.*)$ ]]; then
        num="${BASH_REMATCH[1]}"
        rest="${BASH_REMATCH[2]}"

        # Already padded?
        if [[ ${#num} -eq 2 ]]; then
          continue
        fi

        new="$(printf "%02d" "$num") - $rest"
        if [[ "$new" != "$base" ]]; then
          if [[ -e "$dir/$new" ]]; then
            echo "⚠ Warning:  Won't rename (target exists) - $dir/$new"
          else
            mv -- "$f" "$dir/$new"
          fi
        fi
      fi
    done
  done
}

album_dir_for_track_dir() {
  local dir="$1"
  local name

  name="$(basename "$dir")"
  if [[ "$name" =~ ^CD[0-9]+$ ]]; then
    dirname "$dir"
  else
    printf '%s\n' "$dir"
  fi
}

find_album_cover() {
  local album_dir="$1"

  [[ -d "$album_dir/.whipper" ]] || return 1
  find "$album_dir/.whipper" -maxdepth 2 -type f \
    \( -iname 'cover.jpg' -o -iname 'cover.jpeg' -o -iname 'folder.jpg' -o -iname 'cover.png' -o -iname 'folder.png' \) \
    -print -quit
}

flac_has_picture() {
  [[ -n "$(metaflac --list --block-type=PICTURE "$1")" ]]
}

copy_album_cover_for_plex() {
  local album_dir="$1"
  local cover="$2"
  local target

  if [[ -e "$album_dir/cover.jpg" || -e "$album_dir/cover.jpeg" || -e "$album_dir/cover.png" || -e "$album_dir/folder.jpg" || -e "$album_dir/folder.png" ]]; then
    return 0
  fi

  case "${cover,,}" in
    *.png) target="$album_dir/cover.png" ;;
    *) target="$album_dir/cover.jpg" ;;
  esac

  if cp -- "$cover" "$target"; then
    echo "Saved Plex cover: $target"
  else
    echo "⚠ Warning:  Could not save Plex cover - $target"
  fi
}

sanitize_path_component() {
  local name="$1"
  local safe upper stem

  safe="$name"
  safe="${safe//:/ - }"
  safe="${safe//\?/}"
  safe="${safe//\*/}"
  safe="${safe//\"/}"
  safe="${safe//</(}"
  safe="${safe//>/)}"
  safe="${safe//\\/ -}"
  safe="${safe//|/ -}"
  safe="${safe//$'\r'/ }"
  safe="${safe//$'\n'/ }"
  safe="${safe//$'\t'/ }"

  while [[ "$safe" == *"  "* ]]; do
    safe="${safe//  / }"
  done
  while [[ "$safe" == " "* ]]; do
    safe="${safe# }"
  done
  while [[ "$safe" == *" " ]]; do
    safe="${safe% }"
  done
  while [[ "$safe" == *"." ]]; do
    safe="${safe%.}"
  done

  [[ -n "$safe" ]] || safe="_"

  upper="${safe^^}"
  stem="${upper%%.*}"
  case "$stem" in
    CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9]) safe="_$safe" ;;
  esac

  printf '%s\n' "$safe"
}

unique_sanitized_target() {
  local dir="$1"
  local name="$2"
  local original="$3"
  local stem ext target i

  target="$dir/$name"
  if [[ "$target" == "$original" || ! -e "$target" ]]; then
    printf '%s\n' "$target"
    return 0
  fi

  if [[ "$name" == *.* && "$name" != .* ]]; then
    stem="${name%.*}"
    ext=".${name##*.}"
  else
    stem="$name"
    ext=""
  fi

  i=2
  while :; do
    target="$dir/$stem ($i)$ext"
    if [[ ! -e "$target" ]]; then
      printf '%s\n' "$target"
      return 0
    fi
    ((i += 1))
  done
}

sanitize_tree_for_plex() {
  local root="$1"
  local path dir base safe target rel_old rel_new
  local renamed=0
  local paths=()

  [[ -d "$root" ]] || return 0

  mapfile -d '' paths < <(find "$root" -depth -mindepth 1 -print0)
  for path in "${paths[@]}"; do
    [[ -e "$path" ]] || continue
    dir="$(dirname "$path")"
    base="$(basename "$path")"
    safe="$(sanitize_path_component "$base")"
    [[ "$safe" != "$base" ]] || continue

    target="$(unique_sanitized_target "$dir" "$safe" "$path")"
    rel_old="${path#"$root"/}"
    rel_new="${target#"$root"/}"
    mv -- "$path" "$target"
    echo "Renamed for Plex/exFAT: $rel_old -> $rel_new"
    ((renamed += 1))
  done

  if ((renamed > 0)); then
    echo "Sanitized $renamed path name(s) for Plex/exFAT compatibility."
  fi
}

eject_after_session() {
  local label="${1:-session}"

  if [[ "$EJECT_AFTER" != "yes" ]]; then
    return 0
  fi

  echo "Ejecting $DEVICE..."
  set +e
  if need_cmd timeout; then
    timeout "${EJECT_TIMEOUT_SECONDS}s" eject "$DEVICE" >/dev/null 2>&1
  else
    eject "$DEVICE" >/dev/null 2>&1
  fi
  local status=$?
  set -e

  if [[ $status -eq 0 ]]; then
    echo "Ejected: $DEVICE"
  elif [[ $status -eq 124 ]]; then
    echo "⚠ Warning:  $label finished, but eject timed out after ${EJECT_TIMEOUT_SECONDS}s."
  else
    echo "⚠ Warning:  $label finished, but eject failed for $DEVICE."
  fi
}

postprocess_cover_art() {
  local dirs=("$@")
  local dir album_dir cover f embedded_count

  ((${#dirs[@]} > 0)) || return 0

  if ! need_cmd metaflac; then
    echo "⚠ Warning:  metaflac is not installed; cannot verify/embed FLAC cover art."
    return 0
  fi

  for dir in "${dirs[@]}"; do
    [[ -d "$dir" ]] || continue
    album_dir="$(album_dir_for_track_dir "$dir")"
    cover="$(find_album_cover "$album_dir" || true)"
    [[ -n "$cover" ]] || continue

    copy_album_cover_for_plex "$album_dir" "$cover"

    embedded_count=0
    shopt -s nullglob
    for f in "$dir"/*.flac; do
      if flac_has_picture "$f"; then
        continue
      fi
      if metaflac --preserve-modtime --import-picture-from="$cover" "$f"; then
        ((embedded_count += 1))
      else
        echo "⚠ Warning:  Could not embed cover art in $f"
      fi
    done
    shopt -u nullglob

    if ((embedded_count > 0)); then
      echo "Embedded cover art in $embedded_count FLAC file(s) under: $dir"
    fi
  done
}

format_duration() {
  local seconds="$1"
  local h m s

  h=$((seconds / 3600))
  m=$(((seconds % 3600) / 60))
  s=$((seconds % 60))
  if ((h > 0)); then
    printf '%dh %02dm %02ds\n' "$h" "$m" "$s"
  elif ((m > 0)); then
    printf '%dm %02ds\n' "$m" "$s"
  else
    printf '%ds\n' "$s"
  fi
}

track_number_from_path() {
  local path="$1"
  local base raw

  base="$(basename "$path")"
  if [[ "$base" =~ ^([0-9]{1,3})[[:space:]]*-[[:space:]]*.*\.flac$ ]]; then
    raw="${BASH_REMATCH[1]}"
    printf '%s\n' "$((10#$raw))"
    return 0
  fi
  return 1
}

track_score_from_log() {
  local log_file="$1"
  local track="$2"
  local padded

  padded="$(printf '%2d' "$track")"
  if grep -Eq "track[[:space:]]+$padded:[[:space:]]+rip accurate" "$log_file"; then
    echo 3
  elif grep -Eq "track[[:space:]]+$padded:[[:space:]]+rip NOT accurate" "$log_file"; then
    echo 2
  elif grep -Eq "track[[:space:]]+$padded:[[:space:]]+unknown[[:space:]]+\\(error\\)" "$log_file"; then
    echo 0
  else
    echo 1
  fi
}

count_lines() {
  local input="$1"

  if [[ -z "$input" ]]; then
    echo 0
  else
    printf '%s\n' "$input" | wc -l
  fi
}

count_flacs() {
  local stage="$1"

  [[ -d "$stage" ]] || {
    echo 0
    return 0
  }
  find "$stage" -type f -name '*.flac' | wc -l
}

accurip_count() {
  local log_file="$1"
  local pattern="$2"

  [[ -f "$log_file" ]] || {
    echo 0
    return 0
  }
  grep -Ec "$pattern" "$log_file" || true
}

copy_with_parents() {
  local src="$1"
  local from="$2"
  local to="$3"
  local rel target

  rel="${src#"$from"/}"
  target="$to/$rel"
  mkdir -p "$(dirname "$target")"
  cp -p -- "$src" "$target"
}

conflict_safe_path() {
  local target="$1"
  local stamp="$2"
  local dir base stem ext candidate i

  dir="$(dirname "$target")"
  base="$(basename "$target")"
  if [[ "$base" == *.* && "$base" != .* ]]; then
    stem="${base%.*}"
    ext=".${base##*.}"
  else
    stem="$base"
    ext=""
  fi

  candidate="$dir/$stem.attempt-$stamp$ext"
  i=2
  while [[ -e "$candidate" ]]; do
    candidate="$dir/$stem.attempt-$stamp-$i$ext"
    ((i += 1))
  done
  printf '%s\n' "$candidate"
}

find_partial_album_dir_for_conflicts() {
  local dest="$1"
  shift
  local rel target dir

  for rel in "$@"; do
    target="$dest/$rel"
    dir="$(dirname "$target")"
    while [[ "$dir" == "$dest"* && "$dir" != "$dest" && "$dir" != "/" ]]; do
      if [[ -f "$dir/.whipper/PARTIAL_RIP.txt" ]]; then
        printf '%s\n' "$dir"
        return 0
      fi
      dir="$(dirname "$dir")"
    done
  done
  return 1
}

build_merged_stage() {
  local merged="$1"
  shift
  local entries=("$@")
  local entry stage log mode src rel track score current_score stamp target
  declare -A best_src=()
  declare -A best_stage=()
  declare -A best_score=()
  local files=()

  mkdir -p "$merged"

  for entry in "${entries[@]}"; do
    IFS='|' read -r stage log mode <<< "$entry"
    [[ -d "$stage" ]] || continue
    mapfile -t files < <(find "$stage" -type f -name '*.flac' | sort)
    for src in "${files[@]}"; do
      track="$(track_number_from_path "$src" || true)"
      [[ -n "$track" ]] || continue
      score="$(track_score_from_log "$log" "$track")"
      current_score="${best_score[$track]:--1}"
      if ((score > current_score)); then
        best_score["$track"]="$score"
        best_src["$track"]="$src"
        best_stage["$track"]="$stage"
      fi
    done
  done

  for track in "${!best_src[@]}"; do
    copy_with_parents "${best_src[$track]}" "${best_stage[$track]}" "$merged"
  done

  for entry in "${entries[@]}"; do
    IFS='|' read -r stage log mode <<< "$entry"
    [[ -d "$stage" ]] || continue
    stamp="$(date +%Y%m%d-%H%M%S)"
    mapfile -t files < <(find "$stage" -type f ! -name '*.flac' | sort)
    for src in "${files[@]}"; do
      rel="${src#"$stage"/}"
      target="$merged/$rel"
      mkdir -p "$(dirname "$target")"
      if [[ -e "$target" && "$rel" == */.whipper/* ]]; then
        target="$(conflict_safe_path "$target" "$stamp")"
      elif [[ -e "$target" ]]; then
        continue
      fi
      cp -p -- "$src" "$target"
    done
  done
}

print_session_summary() {
  local start_time="$1"
  local status_label="$2"
  local release_id="$3"
  local modes="$4"
  local stage="$5"
  local log_file="$6"
  local retry_outcome="$7"
  local kept_paths="$8"
  local elapsed completed failed accurate not_accurate unknown_error
  local published="${SESSION_PUBLISHED_FILES:-0}"
  local conflicts="${SESSION_CONFLICTS:-0}"

  elapsed="$(format_duration "$(($(date +%s) - start_time))")"
  completed="$(count_flacs "$stage")"
  mapfile -t failed < <(partial_failed_tracks "$stage" "$log_file" 2>/dev/null || true)
  accurate="$(accurip_count "$log_file" 'track[[:space:]]+[0-9]+:[[:space:]]+rip accurate')"
  not_accurate="$(accurip_count "$log_file" 'track[[:space:]]+[0-9]+:[[:space:]]+rip NOT accurate')"
  unknown_error="$(accurip_count "$log_file" 'track[[:space:]]+[0-9]+:[[:space:]]+unknown[[:space:]]+\(error\)')"

  echo
  echo "Session summary:"
  echo "  Status:              $status_label"
  echo "  Elapsed:             $elapsed"
  echo "  Mode(s):             ${modes:-unknown}"
  echo "  Release ID:          ${release_id:-<not selected>}"
  echo "  Completed FLACs:     $completed"
  echo "  Published files:     $published"
  echo "  Conflicts/skipped:   $conflicts"
  echo "  AccurateRip:         accurate $accurate, not accurate $not_accurate, unknown/error $unknown_error"
  echo "  Retry outcome:       ${retry_outcome:-none}"
  if ((${#failed[@]} > 0)); then
    echo "  Failed/suspect:"
    printf '    %s\n' "${failed[@]}"
  else
    echo "  Failed/suspect:      none detected"
  fi
  if [[ -n "${kept_paths:-}" ]]; then
    echo "  Kept staging paths:"
    printf '    %s\n' $kept_paths
  fi
}

publish_staged_output() {
  local stage="$1"
  local dest="$2"
  local src rel target partial_album stamp repair_target copied=0 skipped=0
  local conflicts=()
  local files=()

  mapfile -t files < <(find "$stage" -type f | sort)
  if ((${#files[@]} == 0)); then
    echo "✘ Fail: Whipper finished, but no files were created in the staging directory."
    echo "   Staging directory kept for inspection: $stage"
    return 1
  fi

  for src in "${files[@]}"; do
    rel="${src#"$stage"/}"
    target="$dest/$rel"
    if [[ -e "$target" ]]; then
      conflicts+=("$rel")
    fi
  done

  if ((${#conflicts[@]} > 0)); then
    partial_album="$(find_partial_album_dir_for_conflicts "$dest" "${conflicts[@]}" || true)"
    if [[ -n "$partial_album" ]]; then
      echo
      echo "Existing partial album found; repairing additively without overwriting files:"
      echo "  $partial_album"
      stamp="$(date +%Y%m%d-%H%M%S)"
      for src in "${files[@]}"; do
        rel="${src#"$stage"/}"
        target="$dest/$rel"
        if [[ -e "$target" ]]; then
          if [[ "$rel" == */.whipper/* && "$rel" != */.whipper/cover.* ]]; then
            repair_target="$(conflict_safe_path "$target" "$stamp")"
            mkdir -p "$(dirname "$repair_target")"
            cp -p -- "$src" "$repair_target"
            ((copied += 1))
          else
            ((skipped += 1))
          fi
          continue
        fi
        mkdir -p "$(dirname "$target")"
        cp -p -- "$src" "$target"
        ((copied += 1))
      done
      SESSION_PUBLISHED_FILES=$((SESSION_PUBLISHED_FILES + copied))
      SESSION_CONFLICTS=$((SESSION_CONFLICTS + skipped))
      echo "Repair copied $copied new file(s), skipped $skipped existing file(s)."
      return 0
    fi

    echo
    echo "✘ Fail: Not copying this rip into your library because these files already exist:"
    printf '  %s\n' "${conflicts[@]}"
    echo
    echo "Staged rip kept here:"
    echo "  $stage"
    echo "Move or rename files manually after checking them, then delete the staging folder when done."
    SESSION_CONFLICTS=$((SESSION_CONFLICTS + ${#conflicts[@]}))
    return 1
  fi

  for src in "${files[@]}"; do
    rel="${src#"$stage"/}"
    target="$dest/$rel"
    mkdir -p "$(dirname "$target")"
    cp -p -- "$src" "$target"
    ((copied += 1))
  done

  SESSION_PUBLISHED_FILES=$((SESSION_PUBLISHED_FILES + copied))
  echo "Published rip into library: $dest"
  return 0
}

list_staged_flacs() {
  local stage="$1"
  find "$stage" -type f -name '*.flac' | sort
}

partial_failed_tracks() {
  local stage="$1"
  local log_file="$2"
  local src base raw num line n
  declare -A completed=()
  declare -A expected=()
  declare -A failed=()

  while IFS= read -r src; do
    base="$(basename "$src")"
    if [[ "$base" =~ ^([0-9]{1,3})[[:space:]]*-[[:space:]]*.*\.flac$ ]]; then
      raw="${BASH_REMATCH[1]}"
      num=$((10#$raw))
      ((num == 0)) && continue
      completed["$num"]=1
    fi
  done < <(list_staged_flacs "$stage")

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ripping[[:space:]]track[[:space:]]([0-9]+)[[:space:]]of[[:space:]]([0-9]+) ]]; then
      num=$((10#${BASH_REMATCH[1]}))
      ((num == 0)) && continue
      expected["$num"]=1
    fi
    if [[ "$line" =~ giving[[:space:]]up[[:space:]]on[[:space:]]track[[:space:]]([0-9]+) ]]; then
      num=$((10#${BASH_REMATCH[1]}))
      ((num == 0)) && continue
      expected["$num"]=1
      failed["$num"]="track $num"
    fi
  done < "$log_file"

  {
    for n in "${!expected[@]}"; do
      printf '%s\n' "$n"
    done
    for n in "${!failed[@]}"; do
      printf '%s\n' "$n"
    done
  } | sort -n -u | while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    if [[ -n "${failed[$n]:-}" ]]; then
      printf '%s\n' "${failed[$n]}"
    elif [[ -z "${completed[$n]:-}" ]]; then
      printf 'track %s (missing or interrupted)\n' "$n"
    fi
  done
}

print_partial_rip_summary() {
  local stage="$1"
  local log_file="$2"
  local src rel
  local completed=()
  local failed=()

  mapfile -t completed < <(list_staged_flacs "$stage")
  mapfile -t failed < <(partial_failed_tracks "$stage" "$log_file")

  echo
  echo "Partial rip summary:"
  if ((${#completed[@]} > 0)); then
    echo "  Completed FLAC files:"
    for src in "${completed[@]}"; do
      rel="${src#"$stage"/}"
      echo "    $rel"
    done
  fi

  if ((${#failed[@]} > 0)); then
    echo "  Failed or suspect tracks:"
    printf '    %s\n' "${failed[@]}"
  else
    echo "  Failed or suspect tracks: see Whipper output above."
  fi
}

write_partial_rip_marker() {
  local stage="$1"
  local log_file="$2"
  local marker_dir marker

  marker_dir="$(find "$stage" -type d -name .whipper -print -quit)"
  [[ -n "$marker_dir" ]] || return 0

  marker="$marker_dir/PARTIAL_RIP.txt"
  {
    echo "PARTIAL RIP"
    echo
    echo "This album was published after Whipper failed to rip one or more tracks."
    echo "Re-rip this CD later to replace or complete the missing tracks."
    echo
    echo "Published: $(date -Is)"
    echo "Device: $DEVICE"
    echo
    print_partial_rip_summary "$stage" "$log_file"
  } > "$marker"
}

publish_partial_rip_if_any() {
  local stage="$1"
  local dest="$2"
  local log_file="$3"
  local dirs=()
  local flacs=()

  mapfile -t flacs < <(list_staged_flacs "$stage")
  if ((${#flacs[@]} == 0)); then
    return 1
  fi

  echo "Sanitizing staged paths for Plex/exFAT..."
  sanitize_tree_for_plex "$stage"
  mapfile -t flacs < <(list_staged_flacs "$stage")
  mapfile -t dirs < <(find "$stage" -type f -name '*.flac' -printf '%h\n' | sort -u)

  echo
  echo "⚠ Warning: Whipper failed before completing the album, but some tracks were ripped."
  print_partial_rip_summary "$stage" "$log_file"
  write_partial_rip_marker "$stage" "$log_file"

  echo "Post-processing partial rip..."
  if [[ "$PAD_TRACK_NUMBERS" == "yes" && ${#dirs[@]} -gt 0 ]]; then
    pad_tracks_in_dirs "${dirs[@]}"
  fi
  if [[ "$COVER_MODE" == "embed" || "$COVER_MODE" == "complete" ]]; then
    postprocess_cover_art "${dirs[@]}"
  fi

  echo "Publishing partial rip into library..."
  if publish_staged_output "$stage" "$dest"; then
    echo
    echo "⚠ Warning: Published a PARTIAL album. Re-rip this CD later to replace/complete the missing tracks."
    eject_after_session "Partial rip"
    return 0
  fi

  stage_out=""
  return 1
}

rip_cd() {
  local damaged_mode="${1:-no}"
  ensure_deps || return 1
  if [[ -z "$DEVICE" ]]; then
    pick_device || return 1
  fi
  mkdir -p "$OUT_ROOT"

  echo
  echo "Insert the CD you want to rip, then press ENTER."
  read -r

  local TT DT
  TT="$(track_template)"
  DT="$(disc_template)"

  local start_time release_modes retry_outcome kept_paths final_status log yn
  local RELEASE_ID="" final_stage="" final_log="" merged_stage="" merged_log="" rc=0
  local attempt_entries=()
  local attempt_stages=()
  local attempt_logs=()
  local work_dirs=()
  local dirs=()
  SESSION_PUBLISHED_FILES=0
  SESSION_CONFLICTS=0
  start_time="$(date +%s)"
  release_modes=""
  retry_outcome="none"
  kept_paths=""

  cleanup_rip_tmp() {
    local path keep
    for path in "${work_dirs[@]:-}"; do
      [[ -n "$path" && "$path" == /tmp/whipper-work-* ]] && rm -rf -- "$path"
    done
    for path in "${attempt_logs[@]:-}" "$merged_log"; do
      [[ -n "$path" ]] && rm -f -- "$path"
    done
    for path in "${attempt_stages[@]:-}" "$merged_stage"; do
      [[ -n "$path" && "$path" == /tmp/whipper-out-* ]] || continue
      keep="no"
      if [[ -n "${kept_paths:-}" ]]; then
        while IFS= read -r kept; do
          [[ "$path" == "$kept" ]] && keep="yes"
        done <<< "$kept_paths"
      fi
      [[ "$keep" == "yes" ]] || rm -rf -- "$path"
    done
  }
  trap 'cleanup_rip_tmp; trap - RETURN' RETURN

  echo
  echo "Ripping with:"
  echo "  Device:      $DEVICE"
  echo "  Output root: $OUT_ROOT"
  echo "  Track tpl:   $TT"
  echo "  Disc tpl:    $DT"
  echo "  Cover art:   $COVER_MODE"
  if [[ "$damaged_mode" == "yes" ]]; then
    echo "  Retries:     $DAMAGED_MAX_RETRIES"
    echo "  Mode:        damaged disc"
    echo "Damaged disc mode: using $DAMAGED_MAX_RETRIES max retry/retries per track to avoid long stalls."
  else
    echo "  Retries:     $MAX_RETRIES"
    if [[ "$MAX_RETRIES" =~ ^[0-9]+$ && "$MAX_RETRIES" -ge 5 ]]; then
      echo "  Note:        badly damaged tracks can take a long time with $MAX_RETRIES retries."
    fi
  fi
  echo

  run_logged_with_bad_disc_watch() {
    local log_file="$1"
    local allow_prompt="$2"
    shift 2
    local line status pid yn
    local q_errors q_track q_total=0 q_prompted="no"
    BAD_DISC_ABORTED="no"
    : > "$log_file"

    set +e
    coproc WPW_RIP { "$@" 2>&1; }
    pid="$WPW_RIP_PID"
    while IFS= read -r line <&"${WPW_RIP[0]}"; do
      printf '%s\n' "$line" | tee -a "$log_file"
      if [[ "$allow_prompt" == "yes" && "$q_prompted" == "no" && "$line" =~ Track[[:space:]]+([0-9]+)[[:space:]]+finished,[[:space:]]+found[[:space:]]+([0-9]+)[[:space:]]+Q[[:space:]]sub-channels[[:space:]]with[[:space:]]CRC[[:space:]]errors ]]; then
        q_track="${BASH_REMATCH[1]}"
        q_errors="${BASH_REMATCH[2]}"
        q_total=$((q_total + q_errors))
        if ((q_errors >= BAD_DISC_TRACK_Q_THRESHOLD || q_total >= BAD_DISC_TOTAL_Q_THRESHOLD)); then
          q_prompted="yes"
          echo
          echo "⚠ Warning: This disc is reporting very high sub-channel CRC errors."
          echo "   Track $q_track reported $q_errors errors; current total is $q_total."
          if [[ -r /dev/tty ]] && read -rp "Stop this normal attempt and restart in damaged disc mode? [Y/n] " yn </dev/tty; then
            if ! is_no "${yn:-}"; then
              BAD_DISC_ABORTED="yes"
              kill "$pid" >/dev/null 2>&1
              break
            fi
          else
            echo "   No interactive terminal is available; continuing the current attempt."
          fi
        fi
      fi
    done
    wait "$pid"
    status=$?
    set -e
    return "$status"
  }

  run_attempt() {
    local cover_mode="$1"
    local mode="$2"
    local stage work log retry_limit allow_bad_disc_prompt status
    local args=()

    stage="$(mktemp -d -t whipper-out-XXXXXX)"
    work="$(mktemp -d -t whipper-work-XXXXXX)"
    log="$(mktemp -t whipper-run-XXXXXX.log)"
    attempt_stages+=("$stage")
    attempt_logs+=("$log")
    work_dirs+=("$work")

    retry_limit="$MAX_RETRIES"
    allow_bad_disc_prompt="no"
    if [[ "$mode" == "damaged" ]]; then
      retry_limit="$DAMAGED_MAX_RETRIES"
    elif [[ "$damaged_mode" != "yes" ]]; then
      allow_bad_disc_prompt="yes"
    fi

    args=(
      cd -d "$DEVICE" rip
      --output-directory "$stage"
      --working-directory "$work"
      --track-template "$TT"
      --disc-template "$DT"
      --max-retries "$retry_limit"
    )
    [[ "$cover_mode" != "none" ]] && args+=(--cover-art "$cover_mode")
    if [[ -n "$RELEASE_ID" ]]; then
      args+=(--release-id "$RELEASE_ID")
    elif [[ "$PROMPT_RELEASE" == "yes" ]]; then
      args+=(--prompt)
    fi
    [[ "$ALLOW_UNKNOWN" == "yes" ]] && args+=(--unknown)
    args+=(--keep-going)

    release_modes="${release_modes:+$release_modes, }$mode"
    attempt_entries+=("$stage|$log|$mode")
    run_logged_with_bad_disc_watch "$log" "$allow_bad_disc_prompt" whipper "${args[@]}"
    status=$?
    final_stage="$stage"
    final_log="$log"
    return "$status"
  }

  if [[ "$PROMPT_RELEASE" == "yes" ]]; then
    echo "Release tip: avoid bootlegs/box sets unless that is the disc you actually have."
    echo "If MusicBrainz returns only one release, it will be selected automatically."
    echo "Choose by number below; the long MusicBrainz ID is shown only for reference."
    if choose_release_id; then
      echo
    else
      echo
      echo "Falling back to Whipper's built-in release prompt."
      echo
    fi
  fi

  if [[ "$damaged_mode" == "yes" ]]; then
    if run_attempt "$COVER_MODE" damaged; then
      rc=0
    else
      rc=$?
    fi
  else
    if run_attempt "$COVER_MODE" normal; then
      rc=0
    else
      rc=$?
      if [[ "${BAD_DISC_ABORTED:-no}" == "yes" ]]; then
        retry_outcome="normal attempt stopped after bad-disc warning; damaged mode attempted"
        echo
        echo "Restarting in damaged disc mode."
        if run_attempt "$COVER_MODE" damaged; then
          rc=0
        else
          rc=$?
        fi
      elif looks_like_cover_art_network_failure "$final_log"; then
        echo
        echo "⚠ Warning:  Whipper failed while fetching cover art, before completing the rip."
        read -rp "Retry this rip without Whipper cover-art fetching? [Y/n] " retry_coverless
        if ! is_no "${retry_coverless:-}"; then
          retry_outcome="cover-art-free retry attempted"
          echo
          echo "Retrying without --cover-art. Audio metadata and AccurateRip verification still apply."
          echo
          if run_attempt none normal; then
            rc=0
          else
            rc=$?
          fi
        fi
      fi

      if [[ "${BAD_DISC_ABORTED:-no}" != "yes" && "$rc" -ne 0 && "$damaged_mode" != "yes" && "$(count_flacs "$final_stage")" -gt 0 ]] && rip_log_has_failed_tracks "$final_log"; then
        echo
        echo "This looks like a damaged disc."
        read -rp "Retry once in damaged disc mode before publishing the partial rip? [Y/n] " yn
        if ! is_no "${yn:-}"; then
          retry_outcome="damaged mode retry attempted"
          echo
          echo "Retrying in damaged disc mode: using $DAMAGED_MAX_RETRIES max retry/retries per track."
          echo
          if run_attempt "$COVER_MODE" damaged; then
            rc=0
          else
            rc=$?
          fi
        fi
      fi
    fi
  fi

  if ((${#attempt_entries[@]} > 1)); then
    merged_stage="$(mktemp -d -t whipper-out-XXXXXX)"
    merged_log="$(mktemp -t whipper-run-merged-XXXXXX.log)"
    build_merged_stage "$merged_stage" "${attempt_entries[@]}"
    for log in "${attempt_logs[@]}"; do
      printf '\n===== %s =====\n' "$log" >> "$merged_log"
      cat "$log" >> "$merged_log"
    done
    final_stage="$merged_stage"
    final_log="$merged_log"
  fi

  if [[ "$rc" -ne 0 ]]; then
    echo
    if [[ "$retry_outcome" == *"damaged"* ]]; then
      echo "✘ Fail: Damaged disc retry also failed."
    else
      echo "✘ Fail: Rip failed."
    fi
    diagnose_rip_failure "$final_log"
  fi

  if ! stage_has_flacs "$final_stage"; then
    echo "   No usable FLAC files were staged."
    final_status="failed - no audio published"
    print_session_summary "$start_time" "$final_status" "$RELEASE_ID" "$release_modes" "$final_stage" "$final_log" "$retry_outcome" ""
    return "${rc:-1}"
  fi

  echo "Sanitizing staged paths for Plex/exFAT..."
  sanitize_tree_for_plex "$final_stage"
  mapfile -t dirs < <(find "$final_stage" -type f -name '*.flac' -printf '%h\n' | sort -u)

  if rip_log_has_failed_tracks "$final_log"; then
    print_partial_rip_summary "$final_stage" "$final_log"
    write_partial_rip_marker "$final_stage" "$final_log"
  fi

  echo "Post-processing staged rip..."
  if [[ "$PAD_TRACK_NUMBERS" == "yes" && ${#dirs[@]} -gt 0 ]]; then
    pad_tracks_in_dirs "${dirs[@]}"
  fi
  if [[ "$COVER_MODE" == "embed" || "$COVER_MODE" == "complete" ]]; then
    postprocess_cover_art "${dirs[@]}"
  fi

  echo "Publishing staged rip into library..."
  if publish_staged_output "$final_stage" "$OUT_ROOT"; then
    final_status="published"
    echo
    if rip_log_has_failed_tracks "$final_log"; then
      echo "⚠ Warning: Done, but this is a PARTIAL album. Re-rip this CD later to replace/complete missing tracks."
    else
      echo "✔ Done."
    fi
    eject_after_session "Rip"
  else
    final_status="kept staged - publish blocked"
    kept_paths="$final_stage"
    echo "   No cleanup touched your music directory."
  fi

  print_session_summary "$start_time" "$final_status" "$RELEASE_ID" "$release_modes" "$final_stage" "$final_log" "$retry_outcome" "$kept_paths"
  echo "Tip: disc artefacts (.log/.cue/.m3u) are stored under each album's: .whipper/"

  [[ "$final_status" == published ]] || return 1
  return 0
}

repair_staged_partial() {
  ensure_deps || return 1
  mkdir -p "$OUT_ROOT"

  local stage yn start_time dirs=() status kept_paths=""
  SESSION_PUBLISHED_FILES=0
  SESSION_CONFLICTS=0
  start_time="$(date +%s)"

  echo
  read -rp "Path to staged partial rip directory: " stage
  if [[ -z "${stage:-}" ]]; then
    echo "No staging path entered."
    return 1
  fi
  if [[ ! -d "$stage" ]]; then
    echo "✘ Fail: Not a directory - $stage"
    return 1
  fi
  if [[ "$stage" != /tmp/whipper-out-* ]]; then
    echo "⚠ Warning:  This is not a usual wizard staging path:"
    echo "  $stage"
    read -rp "Continue anyway? [y/N] " yn
    if ! is_yes "${yn:-}"; then
      return 1
    fi
  fi
  if ! find "$stage" -type f \( -name '*.flac' -o -path '*/.whipper/*' \) -print -quit | grep -q .; then
    echo "✘ Fail: Staging path does not contain FLACs or .whipper artefacts."
    return 1
  fi
  if ! find "$stage" -mindepth 3 -type f -name '*.flac' -print -quit | grep -q .; then
    echo "✘ Fail: Staging path does not look like Artist/Album/track files."
    return 1
  fi

  echo "Sanitizing staged paths for Plex/exFAT..."
  sanitize_tree_for_plex "$stage"
  mapfile -t dirs < <(find "$stage" -type f -name '*.flac' -printf '%h\n' | sort -u)

  echo "Post-processing staged rip..."
  if [[ "$PAD_TRACK_NUMBERS" == "yes" && ${#dirs[@]} -gt 0 ]]; then
    pad_tracks_in_dirs "${dirs[@]}"
  fi
  if [[ "$COVER_MODE" == "embed" || "$COVER_MODE" == "complete" ]]; then
    postprocess_cover_art "${dirs[@]}"
  fi

  echo "Repairing library additively..."
  if publish_staged_output "$stage" "$OUT_ROOT"; then
    status="repair completed"
    echo "✔ Repair/merge completed without overwriting existing files."
  else
    status="repair blocked"
    kept_paths="$stage"
    echo "   No cleanup touched your music directory."
  fi

  print_session_summary "$start_time" "$status" "<manual repair>" "manual repair" "$stage" /dev/null "none" "$kept_paths"
  [[ "$status" == "repair completed" ]] || return 1
}

main_menu() {
  local choice rc

  echo
  echo "=== $APP ==="
  echo "Device: ${DEVICE:-<not set>}"
  echo "Output: $OUT_ROOT"
  echo
  echo "1) Install/verify dependencies"
  echo "2) Pick / change CD drive"
  echo "3) Drive setup (analyze + offset)"
  echo "4) Edit ripping preferences"
  echo "5) Rip a CD now"
  echo "6) Rip a CD in damaged disc mode"
  echo "7) Repair/merge a staged partial rip"
  echo "8) Quit"
  echo
  read -rp "Choose [1-8]: " choice
  choice="${choice//[[:space:]]/}"
  case "$choice" in
    1) ensure_deps || rc=$? ;;
    2) pick_device || rc=$? ;;
    3) drive_setup || rc=$? ;;
    4) edit_prefs || rc=$? ;;
    5) rip_cd || rc=$? ;;
    6) rip_cd yes || rc=$? ;;
    7) repair_staged_partial || rc=$? ;;
    8) exit 0 ;;
    *) echo "Invalid choice." ;;
  esac

  if [[ -n "${rc:-}" && "$rc" -ne 0 ]]; then
    echo
    echo "Returning to menu."
  fi
}

load_cfg
KEEP_GOING="yes"
while true; do
  main_menu
done
